;
; WfpNetTrackerDriver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = WfpNetTrackerDriver.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
WfpNetTrackerDriver.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%WfpNetTrackerDriver.DeviceDesc% = WfpNetTrackerDriver_Device, Root\WfpNetTrackerDriver ; TODO: edit hw-id

[WfpNetTrackerDriver_Device.NT]
CopyFiles = File_Copy

[File_Copy]
WfpNetTrackerDriver.sys

;-------------- Service installation
[WfpNetTrackerDriver_Device.NT.Services]
AddService = WfpNetTrackerDriver,%SPSVCINST_ASSOCSERVICE%, WfpNetTrackerDriver_Service_Inst

; -------------- WfpNetTrackerDriver driver install sections
[WfpNetTrackerDriver_Service_Inst]
DisplayName    = %WfpNetTrackerDriver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\WfpNetTrackerDriver.sys

[WfpNetTrackerDriver_Device.NT.Wdf]
KmdfService = WfpNetTrackerDriver, WfpNetTrackerDriver_wdfsect

[WfpNetTrackerDriver_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "WfpNetTrackerDriver Installation Disk"
WfpNetTrackerDriver.DeviceDesc = "WfpNetTrackerDriver Device"
WfpNetTrackerDriver.SVCDESC = "WfpNetTrackerDriver Service"
